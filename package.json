{
  "name": "hanapure-shop",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:browser": "npm run build && playwright test",
    "test:erp": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/erp-product-operational.test.mjs ./tests/https-operational-source.test.mjs ./tests/emergency-override.test.mjs ./tests/effective-operational-state.test.mjs ./tests/emergency-override-mutations.test.mjs",
    "test:erp:postgres": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/postgres-emergency-override-store.integration.test.mjs",
    "test:admin": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/admin-auth.test.mjs ./tests/admin-authorization.test.mjs ./tests/authorized-emergency-override.test.mjs ./tests/admin-server-boundary.test.mjs",
    "test:admin:postgres": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/admin-authorization.integration.test.mjs",
    "test:staging": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/staging-dependencies.test.mjs",
    "test:staging:readiness": "node --conditions=react-server --import ./tests/server-only-loader.mjs --test ./tests/staging-readiness.test.mjs",
    "smoke:staging": "node --conditions=react-server --import ./tests/server-only-loader.mjs ./scripts/staging-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
